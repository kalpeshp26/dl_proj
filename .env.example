# DeepRetail Environment Configuration
# Copy this file to .env and modify variables as needed.

# Backend server
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# Camera and Vision
CAMERA_INDEX=0
FRAME_WIDTH=1280
FRAME_HEIGHT=720
TARGET_FPS=15

# Detector Backend: auto, trained, world
DETECTOR_BACKEND=auto

# Session
DEFAULT_SESSION_ID=demo_session
